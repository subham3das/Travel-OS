# ── Application Environment ──
NODE_ENV=development
PORT=5000
APP_NAME=TravelOS_API
API_PREFIX=/api
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# ── MongoDB Database ──
MONGODB_URI=mongodb://localhost:27017/travelos_db
MONGODB_MAX_POOL_SIZE=50

# ── JWT Authentication ──
JWT_ACCESS_SECRET=travelos_super_secure_access_secret_key_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=travelos_super_secure_refresh_secret_key_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary Media Storage ──
CLOUDINARY_CLOUD_NAME=travelos_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── Transactional Email (SMTP) ──
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM_NAME=Travel OS
EMAIL_FROM_ADDRESS=support@travelos.com

# ── Payment Gateways ──
RAZORPAY_KEY_ID=rzp_test_samplekey123
RAZORPAY_KEY_SECRET=sample_secret_key_123
STRIPE_SECRET_KEY=sk_test_samplekey123
STRIPE_WEBHOOK_SECRET=whsec_samplekey123

# ── Security & Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=debug
